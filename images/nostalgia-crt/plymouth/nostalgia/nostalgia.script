// Nostalgia CRT splash. Plymouth refreshes the script at 30 frames per second.
Window.SetBackgroundTopColor(0.02, 0.02, 0.02);
Window.SetBackgroundBottomColor(0.02, 0.02, 0.02);

bg = Image("background.png");
bg_scale = Math.Min(Window.GetWidth() / bg.GetWidth(), Window.GetHeight() / bg.GetHeight());
bg = bg.Scale(bg.GetWidth() * bg_scale, bg.GetHeight() * bg_scale);
bg_sprite = Sprite(bg);
bg_sprite.SetPosition(Window.GetWidth() / 2 - bg.GetWidth() / 2,
                      Window.GetHeight() / 2 - bg.GetHeight() / 2, -1000);

logo = Image("logo.png");
logo_scale = Math.Min(1.0, Window.GetWidth() / 1920.0);
logo = logo.Scale(logo.GetWidth() * logo_scale, logo.GetHeight() * logo_scale);
logo_sprite = Sprite(logo);
logo_sprite.SetPosition(Window.GetWidth() / 2 - logo.GetWidth() / 2,
                        Window.GetHeight() * 0.35 - logo.GetHeight() / 2, -500);

// Crop the existing 30-frame sheet once, then swap complete images on refresh.
sheet = Image("spinner.png");
for (i = 0; i < 30; i++)
    spinner_frames[i] = sheet.Crop(i * 60, 0, 60, 60);
spinner_sprite = Sprite(spinner_frames[0]);
spinner_sprite.SetPosition(Window.GetWidth() / 2 - 30, Window.GetHeight() * 0.62 - 30, -400);
current = 0;
prompt_sprite = Sprite();
prompt_sprite.SetZ(1000);

fun refresh_callback() {
    spinner_sprite.SetImage(spinner_frames[current]);
    current = (current + 1) % 30;
}
Plymouth.SetRefreshFunction(refresh_callback);

// Keep password and question prompts visible, including encrypted-disk boots.
fun show_prompt(text) {
    image = Image.Text(text, 0.0, 1.0, 0.25, 1.0, "Sans 16", "center");
    prompt_sprite.SetImage(image);
    prompt_sprite.SetPosition(Window.GetWidth() / 2 - image.GetWidth() / 2,
                              Window.GetHeight() * 0.75, 1000);
    prompt_sprite.SetOpacity(1);
    spinner_sprite.SetOpacity(0);
}
fun password_callback(prompt, bullets) {
    text = prompt + "\n";
    for (i = 0; i < bullets; i++) text += "*";
    show_prompt(text);
}
fun question_callback(prompt, entry) {
    show_prompt(prompt + "\n" + entry);
}
fun normal_callback() {
    prompt_sprite.SetOpacity(0);
    spinner_sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(password_callback);
Plymouth.SetDisplayQuestionFunction(question_callback);
Plymouth.SetDisplayNormalFunction(normal_callback);
