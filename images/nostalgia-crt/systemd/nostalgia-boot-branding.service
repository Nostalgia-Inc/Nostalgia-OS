[Unit]
Description=Install Nostalgia GRUB boot branding
After=local-fs.target
RequiresMountsFor=/boot
ConditionPathExists=/boot/grub2/grub.cfg

[Service]
Type=oneshot
# bootc mounts /boot read-only. Remount only in this private namespace;
# the host keeps its original mount policy after the helper exits.
ExecStart=/usr/bin/unshare --mount --propagation private /usr/bin/sh -c 'mount -o remount,rw /boot && exec /usr/libexec/nostalgia-boot-branding'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
