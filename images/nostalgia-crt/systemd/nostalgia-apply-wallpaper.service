[Unit]
Description=Apply Nostalgia wallpaper defaults
After=bazzite-user-setup.service nostalgia-setup.service plasma-plasmashell.service
PartOf=graphical-session.target
ConditionUser=!@system

[Service]
Type=oneshot
ExecStart=/usr/libexec/nostalgia-apply-wallpaper
RemainAfterExit=yes
TimeoutStartSec=90

[Install]
WantedBy=plasma-workspace.target
